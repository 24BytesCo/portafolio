# Variables de entorno de ejemplo para el proyecto (sin secretos reales)

# Resend — API HTTP, no SMTP (Brevo se descartó: exige IP autorizada y este
# servidor tiene IP dinámica). Usado para el formulario de contacto.
# @see https://resend.com
EMAIL_FROM=Portfolio <noreply@example.com>
EMAIL_TO=contact@example.com

RESEND_API_KEY=re_test_key_1234567890

# Cloudflare Turnstile
# Protege el sitio contra bots
# @see https://www.cloudflare.com/products/bot-management/
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0xTEST_SITE_KEY
TURNSTILE_SECRET_KEY=0xTEST_SECRET_KEY

# Flags
# Habilitar/deshabilitar características

# Formulario de contacto
NEXT_PUBLIC_CONTACT_FORM_ENABLED=true

# Server Actions
# Lista separada por comas de hostnames permitidos
ALLOWED_ORIGINS=localhost:3000,example.com,www.example.com

# Analytics (elige uno: plausible | cloudflare | umami)
# En producción se usa Umami autoalojado bajo /stats del propio dominio:
#   NEXT_PUBLIC_ANALYTICS_PROVIDER=umami
#   NEXT_PUBLIC_UMAMI_SRC=/stats/script.js
#   NEXT_PUBLIC_UMAMI_WEBSITE_ID=<id del sitio en el panel de Umami>
#   UMAMI_INTERNAL_URL=http://portafolio-umami:3000   (nombre del contenedor)
# Las cuatro se leen en el BUILD (NEXT_PUBLIC_* y los rewrites de next.config).
# UMAMI_DB_PASSWORD y UMAMI_APP_SECRET son del contenedor de Umami (compose).
# UMAMI_INTERNAL_URL=
# UMAMI_DB_PASSWORD=
# UMAMI_APP_SECRET=
NEXT_PUBLIC_ANALYTICS_PROVIDER=cloudflare
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=example.com
NEXT_PUBLIC_CF_ANALYTICS_TOKEN=cf_measurement_token_example
NEXT_PUBLIC_UMAMI_SRC=https://analytics.example.com/script.js
NEXT_PUBLIC_UMAMI_WEBSITE_ID=00000000-0000-0000-0000-000000000000
NEXT_PUBLIC_CONTACT_CAPTCHA_PROVIDER=none
CONTACT_CAPTCHA_PROVIDER=none


# ── Despliegue con docker-compose.deploy.yml ─────────────────────────────────
# Solo hacen falta si se despliega con el compose (ver
# docker-compose.deploy.example.yml). El compose las lee de este .env con
# ${VAR:?...}: sin valor por defecto, para que un despliegue sin .env aborte en
# vez de arrancar en silencio con una credencial de ejemplo.
#
# La contraseña se genera en el servidor y no se escribe en ningún archivo
# versionado:
#   tr -dc 'A-Za-z0-9._-' < /dev/urandom | head -c 32
POSTGRES_PASSWORD=changeme
